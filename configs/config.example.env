# 通用 Agent 服务配置模板（YAML 语法，文件名沿用 .env）。
# 复制为 configs/config.env 后替换占位符；config.env 保存真实凭据，不入库。
#
# 覆盖顺序：文件值 < ${环境变量} 展开 < AGENT_* 环境变量 < 内置默认值。
# 模型密钥可直接写 api_key，或通过 api_key_env 引用环境变量名。
# 业务工具必须显式 enabled: true 才会注册；启用后配置缺失会启动失败，
# 但外部服务暂不可达不会阻止登录和其他能力使用，调用时返回明确错误。

server:
  host: 127.0.0.1
  port: 8080

# 单模型回退配置；配置 models.connections 后优先使用具名连接。
llm:
  provider: openai
  base_url: ${LLM_BASE_URL}
  api_key: ${LLM_API_KEY}
  model: ${LLM_MODEL}

# 多模型连接。调用方提交消息时可用 model 字段显式选择。
# base_url 需包含版本前缀（例如 https://api.openai.com/v1），客户端只追加 /chat/completions。
models:
  default: deepseek
  connections:
    deepseek:
      base_url: https://api.deepseek.com
      api_key_env: DEEPSEEK_API_KEY
      model: deepseek-chat
      context_window: 65536
      max_output_tokens: 4096
    local:
      base_url: http://127.0.0.1:11434/v1
      api_key: ""
      model: qwen2.5:7b
      context_window: 32768
      max_output_tokens: 2048

# 只读 Prometheus 查询工具。
prometheus:
  enabled: false
  url: ${PROMETHEUS_URL}

# 只读 RabbitMQ Management API 查询工具（不是任务消息队列）。
rabbitmq:
  enabled: false
  management_url: ${RABBITMQ_MANAGEMENT_URL}
  username: ${RABBITMQ_USERNAME}
  password: ${RABBITMQ_PASSWORD}

# Runbook/RAG 知识检索工具与独立导入/评测命令。
embedding:
  provider: openai
  base_url: ${EMBEDDING_BASE_URL}
  api_key: ${EMBEDDING_API_KEY}
  model: ${EMBEDDING_MODEL}
qdrant:
  url: ${QDRANT_URL}
  collection: gooncall_knowledge
  dim: 768
vector_store:
  provider: qdrant
rag:
  enabled: false
  top_k: 8
  candidate_k: 20
  docs_dir: docs
  reranker:
    enabled: false
    provider: tei
    base_url: ${RERANK_BASE_URL}
    api_key: ${RERANK_API_KEY}
    model: ${RERANK_MODEL}

agent:
  max_steps: 15
  timeout_seconds: 180

agent_service:
  listen_addr: 127.0.0.1:8091
  db_path: data/agent.db
  demo_dir: ${AGENT_DEMO_DIR}
  # 示例工具默认关闭，避免与业务工具混用；本地验证时可临时开启。
  demo_tools_enabled: false
  system_prompt: "你是一个通用运维助手。回答简洁准确；需要获取或修改外部信息时使用提供的工具。工具返回错误时先说明原因，再决定是否调整参数。检索知识时说明来源。"
  max_rounds: 8
  run_budget_seconds: 180
  approval_ttl_seconds: 300
  subscriber_buffer: 64
  shutdown_timeout_seconds: 10
  # 本地禁用账号后，运行中服务在该周期内取消其活动运行。
  user_status_poll_seconds: 2

tool:
  timeout_seconds: 30
  max_result_bytes: 262144

# 登录会话与登录失败限流。旧固定 Token 配置已移除。
auth:
  session_ttl_seconds: 86400
  login_max_attempts: 5
  login_window_seconds: 300
  login_limiter_capacity: 1024
